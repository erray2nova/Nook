<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework> <!-- или net8.0-windows -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\Nook.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Product>Nook</Product>
    <Company>erray2nova</Company>
    <Authors>erray2nova</Authors>
    <Description>Nook is a customizable desktop launcher for apps, games, files, and folders.</Description>
    <Copyright>Copyright © 2026 erray2nova</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <Resource Include="Assets\Nook.ico" />
  </ItemGroup>

</Project>
