<Window x:Class="FastPush.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Переименовать"
        Width="340"
        Height="160"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True">

    <Border Background="#1E1E22" CornerRadius="14" BorderBrush="#3E3E42" BorderThickness="2" Padding="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Новое название плитки:" Foreground="#FFFFFF" FontSize="14" Margin="0,0,0,10"/>
            
            <TextBox x:Name="NameTextBox"
                     Background="#2D2D32"
                     Foreground="#FFFFFF"
                     CaretBrush="#FFFFFF"
                     BorderBrush="#505056"
                     FontSize="15"
                     Padding="6,4"
                     Margin="0,0,0,16"
                     KeyDown="NameTextBox_KeyDown"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Width="85" Height="30" Margin="0,0,10,0"
                        Background="#2D2D32" Foreground="#CCCCCC" BorderThickness="0" Cursor="Hand"
                        Click="Cancel_Click"/>
                <Button Content="Сохранить" Width="95" Height="30"
                        Background="#3A7AFE" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                        Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>