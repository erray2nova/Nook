<Window x:Class="FastPush.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Переименовать"
        Width="360"
        Height="175"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True">

    <Border Background="{DynamicResource MenuSurfaceBrush}"
            CornerRadius="18"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1.5"
            Padding="22">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Новое название плитки"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       FontSize="14.5"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"/>

            <TextBox x:Name="NameTextBox"
                     Background="{DynamicResource InputSurfaceBrush}"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     CaretBrush="{DynamicResource AccentBrush}"
                     FontSize="14.5"
                     Margin="0,0,0,16"
                     KeyDown="NameTextBox_KeyDown">
                <TextBox.Template>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1.2"
                                CornerRadius="10"
                                Padding="10,7">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </TextBox.Template>
            </TextBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена"
                        Cursor="Hand"
                        Margin="0,0,8,0"
                        Click="Cancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{DynamicResource InputSurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="16,7">
                                <TextBlock Text="{TemplateBinding Content}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="13"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="Сохранить"
                        Cursor="Hand"
                        Click="Save_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{DynamicResource AccentBrush}"
                                    CornerRadius="9"
                                    Padding="18,7">
                                <TextBlock Text="{TemplateBinding Content}"
                                           Foreground="{DynamicResource AccentForegroundBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="13"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>