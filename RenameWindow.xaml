<Window x:Class="FastPush.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nook"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True">

    <Border Background="{DynamicResource MenuSurfaceBrush}"
            CornerRadius="18"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1.5"
            Padding="22">
        <StackPanel>
            <TextBlock x:Name="DialogTitleText"
                       Text="Редактирование"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,14"/>

            <TextBlock x:Name="PromptLabelText"
                       Text="Название:"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="12.5"
                       Margin="2,0,0,6"/>

            <TextBox x:Name="NameTextBox"
                     Background="{DynamicResource InputSurfaceBrush}"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     CaretBrush="{DynamicResource AccentBrush}"
                     FontSize="14"
                     Margin="0,0,0,14"
                     KeyDown="Input_KeyDown">
                <TextBox.Template>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1.2"
                                CornerRadius="10"
                                Padding="10,8">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </TextBox.Template>
            </TextBox>

            <!-- Секция выбора пути (показывается при добавлении и редактировании плитки) -->
            <StackPanel x:Name="PathEditorPanel" Visibility="Collapsed" Margin="0,0,0,16">
                <TextBlock Text="Путь к программе, папке или ссылка (https://, steam://):"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="12.5"
                           Margin="2,0,0,6"/>

                <TextBox x:Name="PathTextBox"
                         Background="{DynamicResource InputSurfaceBrush}"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         CaretBrush="{DynamicResource AccentBrush}"
                         FontSize="13.5"
                         Margin="0,0,0,10"
                         KeyDown="Input_KeyDown">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="PathBd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1.2"
                                    CornerRadius="10"
                                    Padding="10,8">
                                <ScrollViewer x:Name="PART_ContentHost"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="PathBd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>

                <StackPanel Orientation="Horizontal">
                    <Button Content="📄 Выбрать файл"
                            Cursor="Hand"
                            Margin="0,0,8,0"
                            Click="BrowseFile_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="FileBtnBd"
                                        Background="{DynamicResource InputSurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="12,7">
                                    <TextBlock Text="{TemplateBinding Content}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="FileBtnBd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Content="📁 Выбрать папку"
                            Cursor="Hand"
                            Click="BrowseFolder_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="DirBtnBd"
                                        Background="{DynamicResource InputSurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="12,7">
                                    <TextBlock Text="{TemplateBinding Content}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="DirBtnBd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                <Button Content="Отмена"
                        Cursor="Hand"
                        Margin="0,0,8,0"
                        Click="Cancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{DynamicResource InputSurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16,8">
                                <TextBlock Text="{TemplateBinding Content}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="13"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="Сохранить"
                        Cursor="Hand"
                        Click="Save_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{DynamicResource AccentBrush}"
                                    CornerRadius="10"
                                    Padding="18,8">
                                <TextBlock Text="{TemplateBinding Content}"
                                           Foreground="{DynamicResource AccentForegroundBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="13"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>