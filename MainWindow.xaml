<Window x:Class="FastPush.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="Nook"
        Width="1280"
        Height="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Вкладки категорий сверху и вкладки внутри панели настроек -->
        <Style x:Key="CategoryTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                Padding="18,8"
                                BorderBrush="Transparent"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Вкладки разделов внутри выезжающей панели настроек -->
        <Style x:Key="DrawerSectionTabStyle" TargetType="RadioButton" BasedOn="{StaticResource CategoryTabStyle}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="12,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

<!-- Кнопка с иконкой (шестеренка / закрытие) -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource HeaderSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="BtnBd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.93" ScaleY="0.93"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Универсальная акцентная / вторичная кнопка -->
        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                Padding="18,10"
                                RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputSurfaceBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,9">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Карточка выбора стиля окна (4 темы) -->
        <Style x:Key="ThemeCardRadioStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="CardBd"
                                Background="{DynamicResource InputSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1.4"
                                CornerRadius="12"
                                Padding="12,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="16" Height="16"
                                         Fill="{TemplateBinding Background}"
                                         Stroke="{DynamicResource BorderSubtleBrush}"
                                         StrokeThickness="1"
                                         Margin="0,0,9,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBd" Property="Background" Value="{DynamicResource TileHoverSurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CardBd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="CardBd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кружок акцентного цвета (8 штук) -->
        <Style x:Key="AccentSwatchRadioStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Ring"
                                CornerRadius="17"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                Padding="3"
                                RenderTransformOrigin="0.5,0.5">
                            <Ellipse Fill="{TemplateBinding Background}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.12" ScaleY="1.12"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Плитка приложения с плавной hover-анимацией и акцентным свечением вокруг -->
        <Style x:Key="TileButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="140"/>
            <Setter Property="Margin" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource TileSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="TileRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform X="0" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>

                            <!-- Ореол подсветки вокруг наведенной плитки -->
                            <Border x:Name="GlowLayer"
                                    Background="{DynamicResource AccentBrush}"
                                    CornerRadius="24"
                                    Margin="-3"
                                    Opacity="0"
                                    IsHitTestVisible="False">
                                <Border.Effect>
                                    <BlurEffect Radius="20"/>
                                </Border.Effect>
                            </Border>

                            <!-- Карточка самой плитки -->
                            <Border x:Name="TileBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="22"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1.5"
                                    Padding="12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TileRoot"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1.05" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TileRoot"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="1.05" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TileRoot"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                         To="-5" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="GlowLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.42" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TileRoot"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1.0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TileRoot"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="1.0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TileRoot"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                         To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="GlowLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource TileHoverSurfaceBrush}"/>
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TileBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Системный трей -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="Nook • Beta 0.1 (Ctrl + Alt + Space)"
                        TrayMouseDoubleClick="TrayIcon_DoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Открыть / Скрыть Nook" Click="MenuOpen_Click"/>
                    <MenuItem Header="Настройки" Click="MenuSettings_Click"/>
                    <MenuItem Header="Перезагрузить конфиг" Click="MenuReload_Click"/>
                    <Separator/>
                    <MenuItem x:Name="AutoStartMenuItem"
                              Header="Запускать вместе с Windows"
                              IsCheckable="True"
                              Click="AutoStartMenuItem_Click"/>
                    <Separator/>
                    <MenuItem Header="Выход" Click="MenuExit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- ГЛАВНЫЙ КОНТУР ОКНА -->
        <Border x:Name="OverlayBorder"
                Background="{DynamicResource BackgroundGradientBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1.2"
                CornerRadius="20"
                ClipToBounds="True"
                AllowDrop="True"
                DragEnter="Overlay_DragEnter"
                DragLeave="Overlay_DragLeave"
                Drop="Overlay_Drop">

            <Grid x:Name="RootContent" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="OverlayScale" ScaleX="1" ScaleY="1"/>
                </Grid.RenderTransform>

                <!-- ФОНОВЫЙ СЛОЙ 1: Анимированные пузыри/сферы в цвет палитры -->
                <Canvas x:Name="BubblesCanvas" IsHitTestVisible="False" ClipToBounds="True">
                    <Ellipse Width="580" Height="580" Canvas.Left="-140" Canvas.Top="-160" Fill="{DynamicResource OrbPrimaryBrush}">
                        <Ellipse.CacheMode><BitmapCache RenderAtScale="0.3"/></Ellipse.CacheMode>
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="Orb1Translate" X="0" Y="0"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <Ellipse Width="640" Height="640" Canvas.Right="-170" Canvas.Bottom="-210" Fill="{DynamicResource OrbSecondaryBrush}">
                        <Ellipse.CacheMode><BitmapCache RenderAtScale="0.3"/></Ellipse.CacheMode>
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="Orb2Translate" X="0" Y="0"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <Ellipse Width="420" Height="420" Canvas.Left="430" Canvas.Top="170" Fill="{DynamicResource OrbSecondaryBrush}" Opacity="0.7" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.CacheMode><BitmapCache RenderAtScale="0.3"/></Ellipse.CacheMode>
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="Orb3Scale" ScaleX="1" ScaleY="1"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>

                <!-- ФОНОВЫЙ СЛОЙ 2: Бесшовно плывущая тонкая геометрическая сетка -->
                <Rectangle x:Name="GridPatternLayer" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <DrawingBrush Viewport="0,0,48,48" ViewportUnits="Absolute" TileMode="Tile">
                            <DrawingBrush.Transform>
                                <TranslateTransform x:Name="GridPatternTranslate" X="0" Y="0"/>
                            </DrawingBrush.Transform>
                            <DrawingBrush.Drawing>
                                <GeometryDrawing>
                                    <GeometryDrawing.Geometry>
                                        <GeometryGroup>
                                            <LineGeometry StartPoint="0,0" EndPoint="48,0"/>
                                            <LineGeometry StartPoint="0,0" EndPoint="0,48"/>
                                        </GeometryGroup>
                                    </GeometryDrawing.Geometry>
                                    <GeometryDrawing.Pen>
                                        <Pen Brush="{DynamicResource GridLineBrush}" Thickness="1"/>
                                    </GeometryDrawing.Pen>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- ОСНОВНОЙ ИНТЕРФЕЙС ЛАУНЧЕРА -->
                <Grid Margin="34,24,34,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ВЕРХНИЙ БАР -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <!-- Слева: Логотип, Название и версия beta 0.1 под ним -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="38"
                                    Height="38"
                                    CornerRadius="12"
                                    Background="{DynamicResource AccentBrush}"
                                    Margin="0,0,12,0">
                                <TextBlock Text="N"
                                           Foreground="{DynamicResource AccentForegroundBrush}"
                                           FontSize="19"
                                           FontWeight="ExtraBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Nook"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Margin="0,-2,0,0"/>
                                <TextBlock Text="beta 0.1"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="11.5"
                                           FontWeight="Medium"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- По центру: Полоса выбора категории -->
                        <Border Grid.Column="1"
                                Background="{DynamicResource HeaderSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="15"
                                Padding="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <ItemsControl x:Name="CategoriesContainer">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Border>

                        <!-- Справа: Иконка шестеренки (Настройки) -->
                        <Button Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Настройки"
                                Click="OpenSettingsBtn_Click">
                            <Path Data="M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8M12,10A2,2 0 0,0 10,12A2,2 0 0,0 12,14A2,2 0 0,0 14,12A2,2 0 0,0 12,10M10,22C9.75,22 9.54,21.82 9.5,21.58L9.13,18.93C8.5,18.68 7.96,18.34 7.44,17.94L4.95,18.95C4.73,19.03 4.46,18.95 4.34,18.73L2.34,15.27C2.21,15.05 2.27,14.78 2.46,14.63L4.57,12.97L4.5,12L4.57,11L2.46,9.37C2.27,9.22 2.21,8.95 2.34,8.73L4.34,5.27C4.46,5.05 4.73,4.96 4.95,5.05L7.44,6.05C7.96,5.66 8.5,5.32 9.13,5.07L9.5,2.42C9.54,2.18 9.75,2 10,2H14C14.25,2 14.46,2.18 14.5,2.42L14.87,5.07C15.5,5.32 16.04,5.66 16.56,6.05L19.05,5.05C19.27,4.96 19.54,5.05 19.66,5.27L21.66,8.73C21.79,8.95 21.73,9.22 21.54,9.37L19.43,11L19.5,12L19.43,13L21.54,14.63C21.73,14.78 21.79,15.05 21.66,15.27L19.66,18.73C19.54,18.95 19.27,19.04 19.05,18.95L16.56,17.95C16.04,18.34 15.5,18.68 14.87,18.93L14.5,21.58C14.46,21.82 14.25,22 14,22H10Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="19"
                                  Height="19"
                                  Stretch="Uniform"/>
                        </Button>
                    </Grid>

                    <!-- ЭКРАН ПЛИТОК -->
                    <Grid Grid.Row="1">
                        <!-- Приглашение добавить плитки, если категория пуста -->
                        <Border x:Name="EmptyStatePanel"
                                Background="{DynamicResource CardSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1.2"
                                CornerRadius="24"
                                Padding="42,36"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" MaxWidth="360">
                                <Border Width="56"
                                        Height="56"
                                        CornerRadius="18"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1.2"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,16">
                                    <TextBlock Text="+"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontSize="28"
                                               FontWeight="Light"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,-3,0,0"/>
                                </Border>

                                <TextBlock Text="В этой категории пока пусто"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           TextAlignment="Center"
                                           Margin="0,0,0,8"/>

                                <TextBlock Text="Добавьте любимые программы или игры вручную, либо просто перетащите файлы и папки прямо в это окно."
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="0,0,0,20"/>

                                <Button Content="+ Добавить плитку"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource PrimaryActionButtonStyle}"
                                        Click="AddTileManual_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Сетка плиток -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="TilesContainer" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel MaxWidth="980" HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource TileButtonStyle}"
                                                Tag="{Binding}"
                                                Click="Tile_Click">

                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Переименовать" Click="RenameTile_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="Удалить" Click="DeleteTile_Click"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>

                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image Source="{Binding IconSource}"
                                                       Width="52"
                                                       Height="52"
                                                       Margin="0,0,0,12"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>

                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           TextAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="112"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ЗАТЕМНЕНИЕ ПОД ПАНЕЛЬЮ НАСТРОЕК -->
                <Border x:Name="SettingsScrim"
                        Background="{DynamicResource ScrimBrush}"
                        Opacity="0"
                        Visibility="Collapsed"
                        MouseLeftButtonDown="SettingsScrim_MouseLeftButtonDown"/>

                <!-- ВЫЕЗЖАЮЩАЯ СПРАВА НАЛЕВО ПАНЕЛЬ НАСТРОЕК -->
                <Border x:Name="SettingsDrawer"
                        Width="410"
                        HorizontalAlignment="Right"
                        Background="{DynamicResource DrawerSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1.2,0,0,0"
                        Padding="26,24"
                        Visibility="Collapsed">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="DrawerTranslate" X="420" Y="0"/>
                    </Border.RenderTransform>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Шапка панели настроек -->
                        <Grid Grid.Row="0" Margin="0,0,0,18">
                            <TextBlock Text="Настройки"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                            <Button Content="✕"
                                    Width="34"
                                    Height="34"
                                    FontSize="14"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource IconButtonStyle}"
                                    Click="CloseSettingsBtn_Click"/>
                        </Grid>

                        <!-- Категории внутри настроек: Оформление | Основные | Другое -->
                        <Border Grid.Row="1"
                                Background="{DynamicResource HeaderSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="4"
                                Margin="0,0,0,20"
                                HorizontalAlignment="Stretch">
                            <UniformGrid Columns="3">
                                <RadioButton x:Name="TabAppearanceRadio"
                                             Content="Оформление"
                                             Tag="Appearance"
                                             GroupName="SettingsTabs"
                                             IsChecked="True"
                                             Style="{StaticResource DrawerSectionTabStyle}"
                                             Checked="SettingsTab_Checked"/>
                                <RadioButton x:Name="TabGeneralRadio"
                                             Content="Основные"
                                             Tag="General"
                                             GroupName="SettingsTabs"
                                             Style="{StaticResource DrawerSectionTabStyle}"
                                             Checked="SettingsTab_Checked"/>
                                <RadioButton x:Name="TabOtherRadio"
                                             Content="Другое"
                                             Tag="Other"
                                             GroupName="SettingsTabs"
                                             Style="{StaticResource DrawerSectionTabStyle}"
                                             Checked="SettingsTab_Checked"/>
                            </UniformGrid>
                        </Border>

                        <!-- Контент вкладок настроек -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                            <Grid>
                                <!-- 1. ОФОРМЛЕНИЕ -->
                                <StackPanel x:Name="PanelAppearance">
                                    <TextBlock Text="Стиль окна"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Margin="2,0,0,8"/>

                                    <UniformGrid x:Name="ThemesPanel" Columns="2" Margin="-4,0,-4,18">
                                        <RadioButton Content="Черный" Tag="Black" Background="#121216" GroupName="WindowThemes" Style="{StaticResource ThemeCardRadioStyle}" Click="ThemeOption_Click"/>
                                        <RadioButton Content="Белый" Tag="White" Background="#F5F6FA" GroupName="WindowThemes" Style="{StaticResource ThemeCardRadioStyle}" Click="ThemeOption_Click"/>
                                        <RadioButton Content="Espresso" Tag="Espresso" Background="#2B1D17" GroupName="WindowThemes" Style="{StaticResource ThemeCardRadioStyle}" Click="ThemeOption_Click"/>
                                        <RadioButton Content="Matcha" Tag="Matcha" Background="#182C21" GroupName="WindowThemes" Style="{StaticResource ThemeCardRadioStyle}" Click="ThemeOption_Click"/>
                                    </UniformGrid>

                                    <TextBlock Text="Акцентный цвет"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Margin="2,0,0,8"/>

                                    <WrapPanel x:Name="AccentsPanel" Margin="-4,0,-4,20">
                                        <RadioButton Background="#EC4899" Tag="#EC4899" ToolTip="Розовый (Sakura)" GroupName="AccentSwatches" Style="{StaticResource AccentSwatchRadioStyle}" Click="AccentSwatch_Click"/>
                                        <RadioButton Background="#10B981" Tag="#10B981" ToolTip="Изумрудный" GroupName="AccentSwatches" Style="{StaticResource AccentSwatchRadioStyle}" Click="AccentSwatch_Click"/>
                                        <RadioButton Background="#3B82F6" Tag="#3B82F6" ToolTip="Сапфир" GroupName="AccentSwatches" Style="{StaticResource AccentSwatchRadioStyle}" Click="AccentSwatch_Click"/>
                                        <RadioButton Background="#8B5CF6" Tag="#8B5CF6" ToolTip="Лаванда" GroupName="AccentSwatches" Style="{StaticResource AccentSwatchRadioStyle}" Click="AccentSwatch_Click"/>
                                        <RadioButton Background="#F97316" Tag="#F97316" ToolTip="Мандарин" GroupName="AccentSwatches" Style="{StaticResource AccentSwatchRadioStyle}" Click="AccentSwatch_Click"/>
                                        <RadioButton Background="#EAB308" Tag="#EAB308" ToolTip="Янтарный" GroupName="AccentSwatches" Style="{StaticResource AccentSwatchRadioStyle}" Click="AccentSwatch_Click"/>
                                        <RadioButton Background="#06B6D4" Tag="#06B6D4" ToolTip="Бирюза" GroupName="AccentSwatches" Style="{StaticResource AccentSwatchRadioStyle}" Click="AccentSwatch_Click"/>
                                        <RadioButton Background="#EF4444" Tag="#EF4444" ToolTip="Рубиновый" GroupName="AccentSwatches" Style="{StaticResource AccentSwatchRadioStyle}" Click="AccentSwatch_Click"/>
                                    </WrapPanel>

                                    <Grid Margin="2,0,2,6">
                                        <TextBlock Text="Плотность Blur-стекла"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="BlurValueText"
                                                   Text="82%"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="13.5"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Slider x:Name="BlurSlider"
                                            Minimum="25"
                                            Maximum="95"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            Value="82"
                                            Margin="0,0,0,22"
                                            ValueChanged="BlurSlider_ValueChanged"/>

                                    <TextBlock Text="Анимации заднего плана"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Margin="2,0,0,12"/>

                                    <Grid Margin="2,0,2,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Градиентные пузыри" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13.5"/>
                                            <TextBlock Text="Плавное свечение в тон темы и акцента" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5"/>
                                        </StackPanel>
                                        <CheckBox x:Name="BubblesToggle" Grid.Column="1" Style="{StaticResource ThemedSwitchStyle}" VerticalAlignment="Center" Click="DesignToggle_Click"/>
                                    </Grid>

                                    <Grid Margin="2,0,2,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Движущаяся сетка" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13.5"/>
                                            <TextBlock Text="Тонкий геометрический паттерн на фоне" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5"/>
                                        </StackPanel>
                                        <CheckBox x:Name="GridToggle" Grid.Column="1" Style="{StaticResource ThemedSwitchStyle}" VerticalAlignment="Center" Click="DesignToggle_Click"/>
                                    </Grid>
                                </StackPanel>

                                <!-- 2. ОСНОВНЫЕ -->
                                <StackPanel x:Name="PanelGeneral" Visibility="Collapsed">
                                    <Grid Margin="2,0,2,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Запускать вместе с Windows" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13.5"/>
                                            <TextBlock Text="Тихий старт в системный трей" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5"/>
                                        </StackPanel>
                                        <CheckBox x:Name="AutoStartToggle" Grid.Column="1" Style="{StaticResource ThemedSwitchStyle}" VerticalAlignment="Center" Click="AutoStartToggle_Click"/>
                                    </Grid>

                                    <Grid Margin="2,0,2,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Скрывать после запуска" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13.5"/>
                                            <TextBlock Text="Сворачивать окно при клике по плитке" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5"/>
                                        </StackPanel>
                                        <CheckBox x:Name="HideAfterLaunchToggle" Grid.Column="1" Style="{StaticResource ThemedSwitchStyle}" VerticalAlignment="Center" Click="DesignToggle_Click"/>
                                    </Grid>

                                    <Grid Margin="2,0,2,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Плавные переходы окна" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13.5"/>
                                            <TextBlock Text="Анимация открытия оверлея и вкладок" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SmoothAnimToggle" Grid.Column="1" Style="{StaticResource ThemedSwitchStyle}" VerticalAlignment="Center" Click="DesignToggle_Click"/>
                                    </Grid>

                                    <Border Background="{DynamicResource CardSurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="14,12"
                                            Margin="0,6,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Быстрый вызов" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,0,0,3"/>
                                            <TextBlock Text="Ctrl + Alt + Space" Foreground="{DynamicResource AccentBrush}" FontSize="14.5" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- 3. ДРУГОЕ -->
                                <StackPanel x:Name="PanelOther" Visibility="Collapsed">
                                    <Border Background="{DynamicResource CardSurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="16"
                                            Margin="0,0,0,18">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AccentBrush}" Margin="0,0,14,0">
                                                <TextBlock Text="N" Foreground="{DynamicResource AccentForegroundBrush}" FontSize="20" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Nook Launcher" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="15" FontWeight="Bold"/>
                                                <TextBlock Text="Версия Beta 0.1 • Легкий лаунчер" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Button Content="Добавить плитку в текущую вкладку" Style="{StaticResource SecondaryActionButtonStyle}" Click="AddTileManual_Click"/>
                                    <Button Content="Перезагрузить config.json" Style="{StaticResource SecondaryActionButtonStyle}" Click="MenuReload_Click"/>
                                    <Button Content="Открыть папку конфигурации" Style="{StaticResource SecondaryActionButtonStyle}" Click="OpenConfigFolder_Click"/>
                                    <Button Content="Сбросить оформление по умолчанию" Style="{StaticResource SecondaryActionButtonStyle}" Click="ResetDesign_Click"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>