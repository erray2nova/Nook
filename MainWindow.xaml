<Window x:Class="FastPush.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="FastPush"
        Width="1280" 
        Height="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Стиль плитки (немного обновили размеры и выравнивание под иконку + текст) -->
        <Style x:Key="TileButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="150"/>
            <Setter Property="Margin" Value="14"/>
            <Setter Property="Background" Value="#252528"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TileBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="22"
                                BorderBrush="#3E3E42"
                                BorderThickness="2"
                                Padding="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="#323236"/>
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="#686870"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="#1B1B1D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Иконка в системном трее -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="FastPush (Ctrl + Alt + Space)"
                        TrayMouseDoubleClick="TrayIcon_DoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Показать / Скрыть" Click="MenuOpen_Click"/>
                    <MenuItem Header="Перезагрузить конфиг" Click="MenuReload_Click"/>
                    <Separator/>
                    <MenuItem Header="Выход" Click="MenuExit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- Фон оверлея -->
        <Border Background="#D9121214" CornerRadius="16" Padding="40">
            
            <!-- ItemsControl автоматически генерирует кнопки на основе списка из кода -->
            <ItemsControl x:Name="TilesContainer" HorizontalAlignment="Center" VerticalAlignment="Center">
                
                <!-- Панель расположения: WrapPanel переносит плитки на новый ряд, если их больше 5 -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel MaxWidth="920" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <!-- Шаблон одной плитки -->
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource TileButtonStyle}"
                                Tag="{Binding Path}"
                                Click="Tile_Click">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Иконка приложения (RenderOptions улучшает четкость мелких значков) -->
                                <Image Source="{Binding IconSource}"
                                       Width="56" 
                                       Height="56"
                                       Margin="0,0,0,12"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <!-- Если иконки нет (например, это папка без своей иконки), прячем пустой блок Image, чтобы текст встал ровно по центру -->
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Style.Triggers>
                                                <Trigger Property="Source" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>

                                <!-- Название плитки -->
                                <TextBlock Text="{Binding Name}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="120"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
        </Border>
    </Grid>
</Window>