<Window x:Class="FastPush.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="Nook"
        Width="1280"
        Height="720"
        MinWidth="800"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown"
        Deactivated="Window_Deactivated"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Вкладка категории (с iPhone-анимацией покачивания и кнопками в режиме редактирования) -->
        <Style x:Key="CategoryTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="TabRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Grid.RenderTransform>

                            <Border x:Name="TabBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="11"
                                    Padding="15,7"
                                    BorderBrush="Transparent"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ContentPresenter VerticalAlignment="Center"/>

                                    <!-- Мини-кнопки управления категорией в режиме редактирования -->
                                    <StackPanel Orientation="Horizontal"
                                                Margin="7,0,-4,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                        <Button Tag="CatRenameBtn"
                                                Content="✎"
                                                ToolTip="Переименовать категорию"
                                                Width="18"
                                                Height="18"
                                                Margin="0,0,3,0"
                                                Cursor="Hand"
                                                Click="CategoryInlineRename_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="RenBd" Background="#28000000" CornerRadius="9">
                                                        <TextBlock Text="✎" FontSize="10" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="RenBd" Property="Background" Value="#55000000"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <Button Tag="CatDeleteBtn"
                                                Content="✕"
                                                ToolTip="Удалить категорию"
                                                Width="18"
                                                Height="18"
                                                Cursor="Hand"
                                                Click="CategoryInlineDelete_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="DelBd" Background="#CCEF4444" CornerRadius="9">
                                                        <TextBlock Text="✕" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="DelBd" Property="Background" Value="#FFDC2626"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Вкладки разделов внутри выезжающей панели настроек -->
        <Style x:Key="DrawerSectionTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="12,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка с иконкой (шестеренка / закрытие) -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource HeaderSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="11"
                                RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="BtnBd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.93" ScaleY="0.93"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка-переключатель Режима Редактирования в шапке -->
        <Style x:Key="EditHeaderToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource HeaderSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="EditBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="13,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="EditBd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="EditBd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="EditBd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="EditBd" Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопки действий -->
        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                Padding="18,10"
                                RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputSurfaceBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,9">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Компактная кнопка внутри полосы категорий (+ и + Плитка) -->
        <Style x:Key="CapsuleMiniButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MiniBd"
                                Background="{DynamicResource InputSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="11,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MiniBd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="MiniBd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Карточка выбора темы и режима анимации -->
        <Style x:Key="ThemeCardRadioStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="CardBd"
                                Background="{DynamicResource InputSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1.4"
                                CornerRadius="11"
                                Padding="11,9">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="14" Height="14"
                                         Fill="{TemplateBinding Background}"
                                         Stroke="{DynamicResource BorderSubtleBrush}"
                                         StrokeThickness="1"
                                         Margin="0,0,8,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBd" Property="Background" Value="{DynamicResource TileHoverSurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CardBd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="CardBd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModePillRadioStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="PillBd"
                                Background="{DynamicResource InputSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1.2"
                                CornerRadius="10"
                                Padding="10,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter TargetName="PillBd" Property="Background" Value="{DynamicResource TileHoverSurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                                <Setter TargetName="PillBd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="PillBd" Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModePillToggleStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="PillBd"
                                Background="{DynamicResource InputSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1.2"
                                CornerRadius="10"
                                Padding="10,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter TargetName="PillBd" Property="Background" Value="{DynamicResource TileHoverSurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                                <Setter TargetName="PillBd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="PillBd" Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кружок акцентного цвета -->
        <Style x:Key="AccentSwatchRadioStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Ring"
                                CornerRadius="17"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                Padding="3"
                                RenderTransformOrigin="0.5,0.5">
                            <Ellipse Fill="{TemplateBinding Background}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.12" ScaleY="1.12"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Плитка приложения (hover-свечение + iPhone-покачивание в режиме редактирования) -->
        <Style x:Key="TileButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="{Binding TileSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="Height" Value="{Binding TileSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="Margin" Value="{Binding TileMargin, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="Background" Value="{DynamicResource TileSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="TileRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform X="0" Y="0"/>
                                    <RotateTransform Angle="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>

                            <!-- Ореол свечения вокруг выбранной плитки -->
                            <Border x:Name="GlowLayer"
                                    Background="{DynamicResource AccentBrush}"
                                    CornerRadius="24"
                                    Margin="-3"
                                    Opacity="0"
                                    IsHitTestVisible="False">
                                <Border.Effect>
                                    <BlurEffect Radius="20"/>
                                </Border.Effect>
                            </Border>

                            <!-- Корпус плитки -->
                            <Border x:Name="TileBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="22"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1.5"
                                    Padding="10">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TileRoot"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1.05" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TileRoot"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="1.05" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TileRoot"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                         To="-5" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="GlowLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.42" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TileRoot"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1.0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TileRoot"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="1.0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TileRoot"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                         To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="GlowLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <!-- Анимация покачивания плиток в стиле iPhone -->
                            <DataTrigger Binding="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard Name="TileJiggleSb">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TileRoot"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(RotateTransform.Angle)"
                                                             From="-1.15" To="1.15" Duration="0:0:0.22"
                                                             AutoReverse="True" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <RemoveStoryboard BeginStoryboardName="TileJiggleSb"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource TileHoverSurfaceBrush}"/>
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TileBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Системный трей -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="Nook • Beta 4.1"
                        TrayMouseDoubleClick="TrayIcon_DoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Открыть / Скрыть Nook" Click="MenuOpen_Click"/>
                    <MenuItem Header="Режим редактирования" Click="MenuEditMode_Click"/>
                    <MenuItem Header="Настройки" Click="MenuSettings_Click"/>
                    <MenuItem Header="Открыть папку конфига (AppData)" Click="OpenConfigFolder_Click"/>
                    <Separator/>
                    <MenuItem x:Name="AutoStartMenuItem"
                              Header="Запускать вместе с Windows"
                              IsCheckable="True"
                              Click="AutoStartMenuItem_Click"/>
                    <Separator/>
                    <MenuItem Header="Выход" Click="MenuExit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- ГЛАВНЫЙ КОНТУР ОКНА (CornerRadius 12 синхронизирован с аппаратным скруглением DWM Windows 11) -->
        <Border x:Name="OverlayBorder"
                Background="{DynamicResource BackgroundGradientBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1.2"
                CornerRadius="12"
                ClipToBounds="True"
                AllowDrop="True"
                DragEnter="Overlay_DragEnter"
                DragLeave="Overlay_DragLeave"
                Drop="Overlay_Drop">

            <Grid x:Name="RootContent" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="OverlayScale" ScaleX="1" ScaleY="1"/>
                </Grid.RenderTransform>

                <!-- 1. Aurora: широкие мягкие цветовые шлейфы -->
                <Canvas x:Name="BubblesCanvas" IsHitTestVisible="False" ClipToBounds="True" Visibility="Collapsed">
                    <Ellipse Width="900" Height="420" Canvas.Left="-280" Canvas.Top="-120" Fill="{DynamicResource OrbPrimaryBrush}" Opacity="0.82" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.CacheMode><BitmapCache RenderAtScale="0.3"/></Ellipse.CacheMode>
                        <Ellipse.RenderTransform>
                            <TransformGroup>
                                <RotateTransform Angle="-18"/>
                                <TranslateTransform x:Name="Orb1Translate" X="0" Y="0"/>
                            </TransformGroup>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <Ellipse Width="820" Height="500" Canvas.Right="-330" Canvas.Bottom="-250" Fill="{DynamicResource OrbSecondaryBrush}" Opacity="0.8" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.CacheMode><BitmapCache RenderAtScale="0.3"/></Ellipse.CacheMode>
                        <Ellipse.RenderTransform>
                            <TransformGroup>
                                <RotateTransform Angle="22"/>
                                <TranslateTransform x:Name="Orb2Translate" X="0" Y="0"/>
                            </TransformGroup>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <Ellipse Width="620" Height="340" Canvas.Left="390" Canvas.Top="180" Fill="{DynamicResource OrbSecondaryBrush}" Opacity="0.52" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.CacheMode><BitmapCache RenderAtScale="0.3"/></Ellipse.CacheMode>
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="Orb3Scale" ScaleX="1" ScaleY="1"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>

                <!-- 2. Grid: медленный почти невесомый параллакс -->
                <Rectangle x:Name="GridPatternLayer" IsHitTestVisible="False" Visibility="Collapsed">
                    <Rectangle.Fill>
                        <DrawingBrush Viewport="0,0,64,64" ViewportUnits="Absolute" TileMode="Tile">
                            <DrawingBrush.Transform>
                                <TranslateTransform x:Name="GridPatternTranslate" X="0" Y="0"/>
                            </DrawingBrush.Transform>
                            <DrawingBrush.Drawing>
                                <GeometryDrawing>
                                    <GeometryDrawing.Geometry>
                                        <GeometryGroup>
                                            <LineGeometry StartPoint="0,0" EndPoint="64,0"/>
                                            <LineGeometry StartPoint="0,0" EndPoint="0,64"/>
                                        </GeometryGroup>
                                    </GeometryDrawing.Geometry>
                                    <GeometryDrawing.Pen>
                                        <Pen Brush="{DynamicResource GridLineBrush}" Thickness="1"/>
                                    </GeometryDrawing.Pen>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- 3. Waves: расходящиеся тонкие кольца -->
                <Grid x:Name="WavesLayer" IsHitTestVisible="False" ClipToBounds="True" Visibility="Collapsed">
                    <Ellipse x:Name="WaveRing1" Width="420" Height="420" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.2" Opacity="0" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="Wave1Scale" ScaleX="0.3" ScaleY="0.3"/></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="WaveRing2" Width="420" Height="420" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1" Opacity="0" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="Wave2Scale" ScaleX="0.3" ScaleY="0.3"/></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="WaveRing3" Width="420" Height="420" Stroke="{DynamicResource AccentBrush}" StrokeThickness="0.8" Opacity="0" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="Wave3Scale" ScaleX="0.3" ScaleY="0.3"/></Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>

                <!-- 4. Bokeh: крупные редкие мягкие частицы -->
                <Canvas x:Name="BokehCanvas" IsHitTestVisible="False" ClipToBounds="True" Visibility="Collapsed"/>

                <!-- 5-8. Метеоры, огни, цветовое дыхание и мерцающие звезды -->
                <Canvas x:Name="CometsCanvas" IsHitTestVisible="False" ClipToBounds="True" Visibility="Collapsed"/>
                <Canvas x:Name="FloatingLightsCanvas" IsHitTestVisible="False" ClipToBounds="True" Visibility="Collapsed"/>
                <Grid x:Name="PulseCanvas" IsHitTestVisible="False" ClipToBounds="True" Visibility="Collapsed">
                    <Ellipse x:Name="PulseGlow"
                             Width="820"
                             Height="820"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Opacity="0.25"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.CacheMode><BitmapCache RenderAtScale="0.3"/></Ellipse.CacheMode>
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#66FFFFFF" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="PulseGlowScale" ScaleX="0.78" ScaleY="0.78"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
                <Canvas x:Name="SparklesCanvas" IsHitTestVisible="False" ClipToBounds="True" Visibility="Collapsed"/>

                <!-- ОСНОВНОЙ ИНТЕРФЕЙС ЛАУНЧЕРА -->
                <Grid Margin="32,22,32,26">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ВЕРХНИЙ БАР -->
                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>

                        <!-- Слева: Логотип, название и версия -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="38"
                                    Height="38"
                                    CornerRadius="12"
                                    Background="{DynamicResource AccentBrush}"
                                    Margin="0,0,12,0">
                                <TextBlock Text="N"
                                           Foreground="{DynamicResource AccentForegroundBrush}"
                                           FontSize="19"
                                           FontWeight="ExtraBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Nook"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Margin="0,-2,0,0"/>
                                <TextBlock x:Name="SubHeaderStatusText"
                                           Text="beta 4.1"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="11.5"
                                           FontWeight="Medium"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- По центру: Полоса категорий + кнопки добавления в режиме Ред. -->
                        <Border Grid.Column="1"
                                Background="{DynamicResource HeaderSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="15"
                                Padding="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled"
                                              MaxWidth="520"
                                              PreviewMouseWheel="Categories_PreviewMouseWheel">
                                    <ItemsControl x:Name="CategoriesContainer">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- Кнопки управления, появляющиеся в режиме редактирования -->
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                    <Border Width="1" Height="20" Background="{DynamicResource BorderSubtleBrush}" Margin="5,0"/>
                                    <Button Content="+ Вкладка"
                                            ToolTip="Создать новую категорию"
                                            Style="{StaticResource CapsuleMiniButtonStyle}"
                                            Click="AddCategory_Click"/>
                                    <Button Content="+ Плитка"
                                            ToolTip="Добавить приложение, папку или ссылку"
                                            Style="{StaticResource CapsuleMiniButtonStyle}"
                                            Click="AddTileManual_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Справа: Часы + Кнопка Редактирования + Шестеренка настроек -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">

                            <!-- Часы -->
                            <StackPanel x:Name="HeaderClockPanel"
                                        VerticalAlignment="Center"
                                        Margin="0,0,14,0">
                                <TextBlock x:Name="ClockTimeText"
                                           Text="00:00"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="16.5"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           Margin="0,-1,0,0"/>
                                <TextBlock x:Name="ClockDateText"
                                           Text="пн, 1 янв"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="11"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>

                            <!-- Кнопка входа в режим редактирования -->
                            <ToggleButton x:Name="EditModeBtn"
                                          Content="✎ Ред."
                                          ToolTip="Режим редактирования категорий и плиток"
                                          Style="{StaticResource EditHeaderToggleStyle}"
                                          Margin="0,0,8,0"
                                          Click="EditModeBtn_Click"/>

                            <!-- Кнопка Настроек -->
                            <Button Style="{StaticResource IconButtonStyle}"
                                    ToolTip="Настройки"
                                    Click="OpenSettingsBtn_Click">
                                <Path Data="M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8M12,10A2,2 0 0,0 10,12A2,2 0 0,0 12,14A2,2 0 0,0 14,12A2,2 0 0,0 12,10M10,22C9.75,22 9.54,21.82 9.5,21.58L9.13,18.93C8.5,18.68 7.96,18.34 7.44,17.94L4.95,18.95C4.73,19.03 4.46,18.95 4.34,18.73L2.34,15.27C2.21,15.05 2.27,14.78 2.46,14.63L4.57,12.97L4.5,12L4.57,11L2.46,9.37C2.27,9.22 2.21,8.95 2.34,8.73L4.34,5.27C4.46,5.05 4.73,4.96 4.95,5.05L7.44,6.05C7.96,5.66 8.5,5.32 9.13,5.07L9.5,2.42C9.54,2.18 9.75,2 10,2H14C14.25,2 14.46,2.18 14.5,2.42L14.87,5.07C15.5,5.32 16.04,5.66 16.56,6.05L19.05,5.05C19.27,4.96 19.54,5.05 19.66,5.27L21.66,8.73C21.79,8.95 21.73,9.22 21.54,9.37L19.43,11L19.5,12L19.43,13L21.54,14.63C21.73,14.78 21.79,15.05 21.66,15.27L19.66,18.73C19.54,18.95 19.27,19.04 19.05,18.95L16.56,17.95C16.04,18.34 15.5,18.68 14.87,18.93L14.5,21.58C14.46,21.82 14.25,22 14,22H10Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="18"
                                      Height="18"
                                      Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- РАБОЧАЯ ОБЛАСТЬ ПЛИТОК -->
                    <Grid Grid.Row="1" Background="#01000000">
                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Добавить плитку..." Click="AddTileManual_Click"/>
                                <MenuItem Header="Создать категорию..." Click="AddCategory_Click"/>
                                <Separator/>
                                <MenuItem Header="Режим редактирования" Click="MenuEditMode_Click"/>
                            </ContextMenu>
                        </Grid.ContextMenu>

                        <!-- Сетка плиток -->
                        <ScrollViewer x:Name="TilesScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="TilesContainer" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button x:Name="TileButton"
                                                Style="{StaticResource TileButtonStyle}"
                                                Tag="{Binding}"
                                                ToolTip="{Binding Path}"
                                                Click="Tile_Click"
                                                PreviewMouseLeftButtonDown="Tile_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="Tile_PreviewMouseMove"
                                                PreviewMouseLeftButtonUp="Tile_PreviewMouseLeftButtonUp"
                                                LostMouseCapture="Tile_LostMouseCapture">

                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Изменить название / исправить путь..." Click="EditTile_Click"/>
                                                    <MenuItem Header="Переименовать" Click="RenameTile_Click"/>
                                                    <MenuItem Header="Сменить иконку..." Click="ChangeTileIcon_Click"/>
                                                    <MenuItem Header="Сведения о плитке..." Click="TileProperties_Click"/>
                                                    <MenuItem Header="Проверить доступность" Click="CheckTileAvailability_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="Путь:"
                                                              IsEnabled="False"/>
                                                    <MenuItem IsEnabled="False"
                                                              Header="{Binding PlacementTarget.Tag.Path, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    <Separator/>
                                                    <MenuItem Header="Открыть расположение файла" Click="OpenFileLocation_Click"/>
                                                    <MenuItem Header="Скопировать путь" Click="CopyTilePath_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="Удалить плитку" Click="DeleteTile_Click"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>

                                            <Grid>
                                                <!-- Бейдж быстрого удаления (как на iOS в режиме редактирования) -->
                                                <Button Tag="QuickDeleteBtn"
                                                        Width="22"
                                                        Height="22"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Panel.ZIndex="3"
                                                        Cursor="Hand"
                                                        ToolTip="Удалить плитку"
                                                        Visibility="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                                        Click="QuickDeleteTileBtn_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="DelCircle" Background="#DDDC2626" CornerRadius="11">
                                                                <TextBlock Text="✕" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="DelCircle" Property="Background" Value="#FFEF4444"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <!-- Индикатор правки в правом верхнем углу в режиме Ред. -->
                                                <Border Width="22"
                                                        Height="22"
                                                        CornerRadius="11"
                                                        Background="{DynamicResource AccentSoftBrush}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        IsHitTestVisible="False"
                                                        Visibility="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="✎" FontSize="11" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0">
                                                    <Image Source="{Binding IconSource}"
                                                           Width="50"
                                                           Height="50"
                                                           Margin="0,0,0,10"
                                                           RenderOptions.BitmapScalingMode="HighQuality"/>

                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               FontSize="13.5"
                                                               FontWeight="SemiBold"
                                                               TextAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="112"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Приглашение добавить плитки (ПОВЕРХ ScrollViewer по ZIndex, поэтому кнопка работает безотказно) -->
                        <Border x:Name="EmptyStatePanel"
                                Panel.ZIndex="5"
                                Background="{DynamicResource CardSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1.2"
                                CornerRadius="24"
                                Padding="42,36"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" MaxWidth="360">
                                <Border Width="56"
                                        Height="56"
                                        CornerRadius="18"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1.2"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,16">
                                    <TextBlock Text="+"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontSize="28"
                                               FontWeight="Light"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,-3,0,0"/>
                                </Border>

                                <TextBlock Text="В этой категории пока пусто"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           TextAlignment="Center"
                                           Margin="0,0,0,8"/>

                                <TextBlock Text="Добавьте программы, папки или ссылки кнопкой ниже, либо включите «✎ Ред.» и перетащите ярлыки прямо в окно."
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="0,0,0,20"/>

                                <Button Content="+ Добавить плитку"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource PrimaryActionButtonStyle}"
                                        Click="AddTileManual_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2"
                            Width="360"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource HeaderSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12,5"
                            Margin="0,10,0,0">
                        <DockPanel LastChildFill="True">
                            <TextBlock Text="⌕"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="20"
                                       VerticalAlignment="Center"
                                       Margin="0,0,9,2"/>
                            <TextBox x:Name="TileSearchTextBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     CaretBrush="{DynamicResource AccentBrush}"
                                     FontSize="13"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Поиск плиток в выбранной категории"
                                     TextChanged="TileSearch_TextChanged"/>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ЗАТЕМНЕНИЕ ПОД ПАНЕЛЬЮ НАСТРОЕК -->
                <Border x:Name="SettingsScrim"
                        Background="{DynamicResource ScrimBrush}"
                        Opacity="0"
                        Visibility="Collapsed"
                        MouseLeftButtonDown="SettingsScrim_MouseLeftButtonDown"/>

                <!-- ВЫЕЗЖАЮЩАЯ СПРАВА НАЛЕВО ПАНЕЛЬ НАСТРОЕК -->
                <Border x:Name="SettingsDrawer"
                        Width="420"
                        HorizontalAlignment="Right"
                        Background="{DynamicResource DrawerSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1.2,0,0,0"
                        Padding="26,22"
                        Visibility="Collapsed">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="DrawerTranslate" X="430" Y="0"/>
                    </Border.RenderTransform>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Шапка панели настроек -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="Настройки"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                            <Button Content="✕"
                                    Width="34"
                                    Height="34"
                                    FontSize="14"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource IconButtonStyle}"
                                    Click="CloseSettingsBtn_Click"/>
                        </Grid>

                        <!-- Вкладки: Оформление | Основные | Другое -->
                        <Border Grid.Row="1"
                                Background="{DynamicResource HeaderSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="4"
                                Margin="0,0,0,18"
                                HorizontalAlignment="Stretch">
                            <UniformGrid Columns="3">
                                <RadioButton x:Name="TabAppearanceRadio"
                                             Content="Оформление"
                                             Tag="Appearance"
                                             GroupName="SettingsTabs"
                                             IsChecked="True"
                                             Style="{StaticResource DrawerSectionTabStyle}"
                                             Checked="SettingsTab_Checked"/>
                                <RadioButton x:Name="TabGeneralRadio"
                                             Content="Основные"
                                             Tag="General"
                                             GroupName="SettingsTabs"
                                             Style="{StaticResource DrawerSectionTabStyle}"
                                             Checked="SettingsTab_Checked"/>
                                <RadioButton x:Name="TabOtherRadio"
                                             Content="Другое"
                                             Tag="Other"
                                             GroupName="SettingsTabs"
                                             Style="{StaticResource DrawerSectionTabStyle}"
                                             Checked="SettingsTab_Checked"/>
                            </UniformGrid>
                        </Border>

                        <!-- Содержимое разделов настроек -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                            <Grid>
                                <!-- 1. ОФОРМЛЕНИЕ -->
                                <StackPanel x:Name="PanelAppearance">
                                    <TextBlock Text="Стиль окна"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Margin="2,0,0,6"/>

                                    <UniformGrid x:Name="ThemesPanel" Columns="2" Margin="-4,0,-4,16">
                                        <RadioButton Content="Черный" Tag="Black" Background="#121216" GroupName="WindowThemes" Style="{StaticResource ThemeCardRadioStyle}" Click="ThemeOption_Click"/>
                                        <RadioButton Content="Белый" Tag="White" Background="#F5F6FA" GroupName="WindowThemes" Style="{StaticResource ThemeCardRadioStyle}" Click="ThemeOption_Click"/>
                                        <RadioButton Content="Espresso" Tag="Espresso" Background="#2B1D17" GroupName="WindowThemes" Style="{StaticResource ThemeCardRadioStyle}" Click="ThemeOption_Click"/>
                                        <RadioButton Content="Matcha" Tag="Matcha" Background="#182C21" GroupName="WindowThemes" Style="{StaticResource ThemeCardRadioStyle}" Click="ThemeOption_Click"/>
                                    </UniformGrid>

                                    <TextBlock Text="Акцентный цвет"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Margin="2,0,0,6"/>

                                    <WrapPanel x:Name="AccentsPanel" Margin="-4,0,-4,16">
                                        <RadioButton Background="#EC4899" Tag="#EC4899" ToolTip="Розовый (Sakura)" GroupName="AccentSwatches" Style="{StaticResource AccentSwatchRadioStyle}" Click="AccentSwatch_Click"/>
                                        <RadioButton Background="#10B981" Tag="#10B981" ToolTip="Изумрудный" GroupName="AccentSwatches" Style="{StaticResource AccentSwatchRadioStyle}" Click="AccentSwatch_Click"/>
                                        <RadioButton Background="#3B82F6" Tag="#3B82F6" ToolTip="Сапфир" GroupName="AccentSwatches" Style="{StaticResource AccentSwatchRadioStyle}" Click="AccentSwatch_Click"/>
                                        <RadioButton Background="#8B5CF6" Tag="#8B5CF6" ToolTip="Лаванда" GroupName="AccentSwatches" Style="{StaticResource AccentSwatchRadioStyle}" Click="AccentSwatch_Click"/>
                                        <RadioButton Background="#F97316" Tag="#F97316" ToolTip="Мандарин" GroupName="AccentSwatches" Style="{StaticResource AccentSwatchRadioStyle}" Click="AccentSwatch_Click"/>
                                        <RadioButton Background="#EAB308" Tag="#EAB308" ToolTip="Янтарный" GroupName="AccentSwatches" Style="{StaticResource AccentSwatchRadioStyle}" Click="AccentSwatch_Click"/>
                                        <RadioButton Background="#06B6D4" Tag="#06B6D4" ToolTip="Бирюза" GroupName="AccentSwatches" Style="{StaticResource AccentSwatchRadioStyle}" Click="AccentSwatch_Click"/>
                                        <RadioButton Background="#EF4444" Tag="#EF4444" ToolTip="Рубиновый" GroupName="AccentSwatches" Style="{StaticResource AccentSwatchRadioStyle}" Click="AccentSwatch_Click"/>
                                    </WrapPanel>

                                    <Grid Margin="2,0,2,4">
                                        <TextBlock Text="Плотность стекла (0% стекло — 100% матовый)"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="BlurValueText"
                                                   Text="72%"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Slider x:Name="BlurSlider"
                                            Minimum="0"
                                            Maximum="100"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            Value="72"
                                            Margin="0,0,0,18"
                                            ValueChanged="BlurSlider_ValueChanged"/>

                                    <TextBlock Text="Размер и плотность сетки"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Margin="2,0,0,6"/>
                                    <UniformGrid x:Name="GridPresetsPanel" Columns="3" Margin="-3,0,-3,10">
                                        <RadioButton Content="Стандартная" Tag="Standard" GroupName="GridPresets" Style="{StaticResource ModePillRadioStyle}" Click="GridPreset_Click"/>
                                        <RadioButton Content="Компактная" Tag="Compact" GroupName="GridPresets" Style="{StaticResource ModePillRadioStyle}" Click="GridPreset_Click"/>
                                        <RadioButton Content="Плотная" Tag="Dense" GroupName="GridPresets" Style="{StaticResource ModePillRadioStyle}" Click="GridPreset_Click"/>
                                    </UniformGrid>

                                    <Grid Margin="2,0,2,2">
                                        <TextBlock Text="Размер плитки"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="12.5"/>
                                        <TextBlock x:Name="TileSizeValueText"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="12.5"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="TileSizeSlider" Minimum="100" Maximum="180" TickFrequency="1"
                                            IsSnapToTickEnabled="True" Margin="0,0,0,8" ValueChanged="GridSlider_ValueChanged"/>

                                    <Grid Margin="2,0,2,2">
                                        <TextBlock Text="Расстояние между плитками"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="12.5"/>
                                        <TextBlock x:Name="TileSpacingValueText"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="12.5"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="TileSpacingSlider" Minimum="1" Maximum="24" TickFrequency="1"
                                            IsSnapToTickEnabled="True" Margin="0,0,0,8" ValueChanged="GridSlider_ValueChanged"/>

                                    <Grid Margin="2,0,2,2">
                                        <TextBlock Text="Непрозрачность плиток"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="12.5"/>
                                        <TextBlock x:Name="TileOpacityValueText"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="12.5"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="TileOpacitySlider" Minimum="30" Maximum="100" TickFrequency="1"
                                            IsSnapToTickEnabled="True" Margin="0,0,0,18" ValueChanged="TileOpacitySlider_ValueChanged"/>

                                    <TextBlock Text="Анимации заднего плана"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Margin="2,0,0,2"/>
                                    <TextBlock x:Name="BgEffectsLimitText"
                                               Text="Выберите не более двух эффектов"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="11.5"
                                               Margin="2,0,0,8"/>

                                    <UniformGrid x:Name="BgEffectsPanel" Columns="2" Margin="0,0,0,18">
                                        <ToggleButton Content="Аврора" Tag="Aurora" Style="{StaticResource ModePillToggleStyle}" Click="BgEffect_Click"/>
                                        <ToggleButton Content="Сетка" Tag="Grid" Style="{StaticResource ModePillToggleStyle}" Click="BgEffect_Click"/>
                                        <ToggleButton Content="Волны" Tag="Waves" Style="{StaticResource ModePillToggleStyle}" Click="BgEffect_Click"/>
                                        <ToggleButton Content="Боке" Tag="Bokeh" Style="{StaticResource ModePillToggleStyle}" Click="BgEffect_Click"/>
                                        <ToggleButton Content="Метеоры" Tag="Comets" Style="{StaticResource ModePillToggleStyle}" Click="BgEffect_Click"/>
                                        <ToggleButton Content="Светлячки" Tag="FloatingLights" Style="{StaticResource ModePillToggleStyle}" Click="BgEffect_Click"/>
                                        <ToggleButton Content="Дыхание" Tag="Pulse" Style="{StaticResource ModePillToggleStyle}" Click="BgEffect_Click"/>
                                        <ToggleButton Content="Звёзды" Tag="Sparkles" Style="{StaticResource ModePillToggleStyle}" Click="BgEffect_Click"/>
                                    </UniformGrid>

                                    <Grid Margin="2,0,2,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Показывать часы в шапке" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13.5"/>
                                            <TextBlock Text="Время и дата в правом верхнем углу" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ShowClockToggle" Grid.Column="1" Style="{StaticResource ThemedSwitchStyle}" VerticalAlignment="Center" Click="DesignToggle_Click"/>
                                    </Grid>
                                </StackPanel>

                                <!-- 2. ОСНОВНЫЕ -->
                                <StackPanel x:Name="PanelGeneral" Visibility="Collapsed">
                                    <TextBlock Text="Горячая клавиша вызова"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Margin="2,0,0,8"/>

                                    <Grid Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="RecordHotkeyButton"
                                                Grid.Column="0"
                                                Content="Ctrl + Alt + Space"
                                                Cursor="Hand"
                                                Margin="0,0,8,0"
                                                Click="RecordHotkeyButton_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="HkBd"
                                                            Background="{DynamicResource InputSurfaceBrush}"
                                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                            BorderThickness="1.3"
                                                            CornerRadius="11"
                                                            Padding="14,10">
                                                        <TextBlock Text="{TemplateBinding Content}"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   FontSize="13.5"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="HkBd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <Button Grid.Column="1"
                                                Content="⌨"
                                                ToolTip="Ввести сочетание вручную"
                                                Cursor="Hand"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource IconButtonStyle}"
                                                Click="ManualHotkeyButton_Click"/>

                                        <Button Grid.Column="2"
                                                Content="↺"
                                                ToolTip="Вернуть Ctrl + Alt + Space"
                                                Width="40"
                                                Height="40"
                                                Style="{StaticResource IconButtonStyle}"
                                                Click="ResetHotkeyBtn_Click"/>
                                    </Grid>

                                    <StackPanel x:Name="ManualHotkeyPanel" Visibility="Collapsed" Margin="0,-10,0,18">
                                        <TextBlock Text="Введите сочетание, например: Shift + Win + A"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="11.5"
                                                   Margin="2,0,0,6"/>
                                        <TextBox x:Name="ManualHotkeyTextBox"
                                                 Background="{DynamicResource InputSurfaceBrush}"
                                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                                 CaretBrush="{DynamicResource AccentBrush}"
                                                 FontSize="13.5"
                                                 Padding="10,8"
                                                 Margin="0,0,0,8"
                                                 KeyDown="ManualHotkeyTextBox_KeyDown"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Отмена"
                                                    Cursor="Hand"
                                                    Margin="0,0,8,0"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Click="CancelManualHotkey_Click"/>
                                            <Button Content="Сохранить"
                                                    Cursor="Hand"
                                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                                    Click="SaveManualHotkey_Click"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Grid Margin="2,0,2,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Скрывать при потере фокуса" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13.5"/>
                                            <TextBlock Text="В режиме «✎ Ред.» окно остается закрепленным" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5"/>
                                        </StackPanel>
                                        <CheckBox x:Name="HideOnDeactivateToggle" Grid.Column="1" Style="{StaticResource ThemedSwitchStyle}" VerticalAlignment="Center" Click="DesignToggle_Click"/>
                                    </Grid>

                                    <Grid Margin="2,0,2,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Скрывать после запуска плитки" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13.5"/>
                                            <TextBlock Text="Сворачивать оверлей при открытии программы" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5"/>
                                        </StackPanel>
                                        <CheckBox x:Name="HideAfterLaunchToggle" Grid.Column="1" Style="{StaticResource ThemedSwitchStyle}" VerticalAlignment="Center" Click="DesignToggle_Click"/>
                                    </Grid>

                                    <Grid Margin="2,0,2,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Плавные переходы интерфейса" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13.5"/>
                                            <TextBlock Text="Анимация всплытия окна и смены категорий" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SmoothAnimToggle" Grid.Column="1" Style="{StaticResource ThemedSwitchStyle}" VerticalAlignment="Center" Click="DesignToggle_Click"/>
                                    </Grid>

                                    <Grid Margin="2,0,2,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Запускать вместе с Windows" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13.5"/>
                                            <TextBlock Text="Тихий фоновый старт сразу в системный трей" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5"/>
                                        </StackPanel>
                                        <CheckBox x:Name="AutoStartToggle" Grid.Column="1" Style="{StaticResource ThemedSwitchStyle}" VerticalAlignment="Center" Click="AutoStartToggle_Click"/>
                                    </Grid>
                                </StackPanel>

                                <!-- 3. ДРУГОЕ -->
                                <StackPanel x:Name="PanelOther" Visibility="Collapsed">
                                    <Border Background="{DynamicResource CardSurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="16"
                                            Margin="0,0,0,16">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AccentBrush}" Margin="0,0,14,0">
                                                <TextBlock Text="N" Foreground="{DynamicResource AccentForegroundBrush}" FontSize="20" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Nook Launcher" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="15" FontWeight="Bold"/>
                                                <TextBlock Text="Beta 4.1 • Данные в %LocalAppData%\Nook" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Button Content="➕ Добавить плитку вручную" Style="{StaticResource SecondaryActionButtonStyle}" Click="AddTileManual_Click"/>
                                    <Button Content="📁 Создать новую категорию" Style="{StaticResource SecondaryActionButtonStyle}" Click="AddCategory_Click"/>
                                    <Button Content="📂 Открыть папку конфига (AppData\Local\Nook)" Style="{StaticResource SecondaryActionButtonStyle}" Click="OpenConfigFolder_Click"/>
                                    <Button Content="🔄 Перезагрузить config.json" Style="{StaticResource SecondaryActionButtonStyle}" Click="MenuReload_Click"/>
                                    <Button Content="⬆ Экспортировать резервную копию..." Style="{StaticResource SecondaryActionButtonStyle}" Click="ExportConfiguration_Click"/>
                                    <Button Content="⬇ Импортировать резервную копию..." Style="{StaticResource SecondaryActionButtonStyle}" Click="ImportConfiguration_Click"/>
                                    <Button Content="↺ Сбросить настройки по умолчанию" Style="{StaticResource SecondaryActionButtonStyle}" Click="ResetDesign_Click"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>